---
// Chips: native checkboxes (multi) or radios styled as toggles; the checked one takes the pixel on its
// corner. Native inputs: keyboard (Space, arrows in a radio group), form data and no-JS for free.
// cols: equal columns from md (pricing); without it chips wrap.
interface Props { name: string; options: { label: string; note?: string; value?: string }[]; multi?: boolean; checked?: string[]; cols?: number; describedby?: string }
const { name, options, multi = false, checked = [], cols, describedby } = Astro.props;
---
<div class:list={['chips', { 'chips--cols': cols }]} style={cols ? `--n:${cols}` : undefined} data-chips={name}>
  {options.map((o) => {
    const v = o.value ?? o.label;
    return (
      <label class="chip">
        <input type={multi ? 'checkbox' : 'radio'} name={name} value={v} checked={checked.includes(v)} aria-describedby={describedby} />
        <span>{o.label}{o.note && <small>{o.note}</small>}</span>
      </label>
    );
  })}
</div>

<style lang="scss">
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .chips--cols {
    display: grid;
    grid-template-columns: minmax(0, 1fr);

    @include mq(md) { grid-template-columns: repeat(var(--n), minmax(0, 1fr)); }
  }

  .chip {
    position: relative;
    display: flex;
    cursor: pointer;

    input { position: absolute; opacity: 0; pointer-events: none; }

    span {
      position: relative;
      flex: 1;
      min-height: 44px;
      padding: var(--space-3) var(--space-4);
      color: var(--muted);
      background: var(--bg);
      border: 1px solid var(--border);
      transition: color var(--duration-fast) var(--ease-soft), border-color var(--duration-fast) var(--ease-soft), background var(--duration-fast) var(--ease-soft);

      &::before {
        content: '';
        position: absolute;
        top: -1px;
        left: -1px;
        width: 6px;
        height: 6px;
        background: var(--accent);
        scale: 0;
        transform-origin: 0 0;
        transition: scale var(--duration-fast) var(--ease-move);
      }
    }

    small { display: block; margin-top: var(--space-1); color: var(--muted); }

    &:hover span { color: var(--text); }

    input:checked + span {
      color: var(--text);
      background: var(--surface);
      border-color: var(--text);

      &::before { scale: 1; }
    }

    input:focus-visible + span { outline: 2px solid var(--accent); outline-offset: 2px; }
  }
</style>
