---
// Option row with a switch: a native checkbox (role="switch"), the whole row is its label.
interface Props { name: string; value: string; label: string; note?: string; price: string; checked?: boolean }
const { name, value, label, note, price, checked = false } = Astro.props;
---
<label class="op">
  <input type="checkbox" role="switch" name={name} value={value} checked={checked} />
  <span class="op__sw" aria-hidden="true"></span>
  <span class="op__t"><b>{label}</b>{note && <small>{note}</small>}</span>
  <span class="mono">{price}</span>
</label>

<style lang="scss">
  .op {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    gap: var(--space-4);
    align-items: center;
    min-height: 44px;
    padding-block: var(--space-4);
    border-bottom: 1px solid var(--border);
    cursor: pointer;

    input { position: absolute; opacity: 0; pointer-events: none; }
  }

  .op__sw {
    position: relative;
    width: 30px;
    height: 14px;
    border: 1px solid var(--muted);
    transition: border-color var(--duration-fast) var(--ease-soft);

    &::after {
      content: '';
      position: absolute;
      top: 1px;
      left: 1px;
      width: 10px;
      height: 10px;
      background: var(--muted);
      transition: translate 0.45s var(--ease-move), background var(--duration-fast) var(--ease-soft);
    }
  }

  input:checked + .op__sw {
    border-color: var(--text);

    &::after { translate: 16px 0; background: var(--accent); }
  }

  input:focus-visible + .op__sw { outline: 2px solid var(--accent); outline-offset: 3px; }

  .op__t {
    display: grid;
    gap: var(--space-1);

    small { color: var(--muted); }
  }

  .mono { color: var(--text); }
</style>
