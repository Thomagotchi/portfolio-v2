---
// Option row with a switch: a native checkbox (role="switch"), the whole row is its label. Price optional.
interface Props { name: string; value: string; label: string; note?: string; price?: string; checked?: boolean }
const { name, value, label, note, price, checked = false } = Astro.props;
---
<label class="op">
  <input type="checkbox" role="switch" name={name} value={value} checked={checked} />
  <span class="op__sw" aria-hidden="true"></span>
  <span class="op__t"><b>{label}</b>{note && <small>{note}</small>}</span>
  {price && <span class="mono">{price}</span>}
</label>

<style lang="scss">
  .op {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    gap: var(--space-4);
    align-items: center;
    min-height: 44px;
    padding-block: var(--space-4);
    border-bottom: 1px solid var(--border);
    cursor: pointer;

    input { position: absolute; opacity: 0; pointer-events: none; }
  }

  // A filled track, no outline: the knob slides right and lights; the accent pixel it uncovers marks "on".
  .op__sw {
    position: relative;
    width: 42px;
    height: 24px;
    background: var(--raised);
    box-shadow: inset 0 0 0 1px var(--border);
    transition: background var(--duration-fast) var(--ease-soft);

    &::before, &::after { content: ''; position: absolute; }

    &::before {
      top: 10px;
      left: 9px;
      width: 4px;
      height: 4px;
      background: var(--accent);
      scale: 0;
      transition: scale var(--duration-fast) var(--ease-move);
    }

    &::after {
      top: 4px;
      left: 4px;
      width: 16px;
      height: 16px;
      background: var(--muted);
      transition: translate 0.45s var(--ease-move), background var(--duration-fast) var(--ease-soft);
    }
  }

  .op:hover .op__sw { background: color-mix(in srgb, var(--text) 8%, var(--raised)); }

  input:checked + .op__sw {
    background: color-mix(in srgb, var(--text) 14%, var(--raised));

    &::before { scale: 1; transition-delay: 0.15s; }
    &::after { translate: 18px 0; background: var(--text); }
  }

  input:focus-visible + .op__sw { outline: 2px solid var(--accent); outline-offset: 3px; }

  .op__t {
    display: grid;
    gap: var(--space-1);

    small { color: var(--muted); }
  }

  .mono { color: var(--text); }
</style>
