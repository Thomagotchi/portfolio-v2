---
// Timeline: a sticky year (6 cells, md+) rolls on a live odometer while the entries scroll; the hairline
// fills with the scroll (to the end of the list) with the pixel at its tip; an entry lights when its top crosses 55% of
// the viewport. Mobile: the big year is hidden, each entry carries its own (always in the markup).
import Odometer from '@/components/ui/Odometer.astro';
import type { AboutPage } from '@/lib/types';

interface Props { entries: AboutPage['timeline'] }
const { entries } = Astro.props;
---
<div class="tl" data-timeline>
  <div class="tl__y" aria-hidden="true">
    <Odometer value={entries[0].year} live class="tl__odo" />
    <span class="tag" data-title>{entries[0].title}</span>
  </div>
  <div class="tl__list">
    <b aria-hidden="true"></b>
    <ol role="list">
    {entries.map((e, i) => (
      <li class:list={['tl__i', { 'is-on': i === 0 }]} data-year={e.year} data-title={e.title}>
        <span class="mono">{e.year}</span>
        <h3>{e.title}</h3>
        <p>{e.text}</p>
        {e.tags.length > 0 && <ul role="list" class="tl__tags">{e.tags.map((t) => <li>{t}</li>)}</ul>}
      </li>
    ))}
    </ol>
  </div>
</div>

<script>
  import { ScrollTrigger, reduceMotion } from '@/scripts/gsap';
  import { decode } from '@/scripts/decode';
  import { setOdometer } from '@/scripts/odometer';

  for (const tl of document.querySelectorAll<HTMLElement>('[data-timeline]')) {
    const list = tl.querySelector<HTMLElement>('.tl__list')!;
    const items = [...list.querySelectorAll<HTMLElement>('.tl__i')];
    const fill = list.querySelector<HTMLElement>(':scope > b')!;
    const odo = tl.querySelector<HTMLElement>('.tl__odo')!;
    const title = tl.querySelector<HTMLElement>('[data-title]')!;
    let cur = -1;
    const update = () => {
      const line = innerHeight * 0.55;
      let c = 0;
      items.forEach((it, i) => { const on = it.getBoundingClientRect().top < line; it.classList.toggle('is-on', on || i === 0); if (on) c = i; });
      const last = items[c];
      // The fill follows the 55% line all the way to the end of the list (it used to stop mid last entry).
      const tip = Math.min(list.offsetHeight, Math.max(8, line - list.getBoundingClientRect().top));
      fill.style.setProperty('--h', `${tip}px`);
      if (c === cur) return;
      cur = c;
      setOdometer(odo, last.dataset.year!);
      decode(title, last.dataset.title!, 500);
    };
    if (reduceMotion()) items.forEach((it) => it.classList.add('is-on'));
    ScrollTrigger.create({ trigger: list, start: 'top bottom', end: 'bottom top', onUpdate: update, onRefresh: update });
  }
</script>

<style lang="scss">
  .tl {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--cell);

    @include mq(md) { grid-template-columns: calc(var(--cell) * 5) minmax(0, 1fr); }

    @include mq(lg) { grid-template-columns: calc(var(--cell) * 6) minmax(0, 1fr); }
  }

  .tl__y {
    position: sticky;
    top: calc(var(--header-h) + var(--space-6));
    display: none;
    align-self: start;
    gap: var(--space-4);

    @include mq(md) { display: grid; }

    :global(.tl__odo) {
      font-size: clamp(56px, 9vw, 120px);
      letter-spacing: -0.04em;
    }
  }

  // The line: 1px hairline on the left; b = the fill (its height) with the pixel at its tip (::after).
  .tl__list {
    position: relative;
    padding-left: calc(var(--cell) * 0.75);

    > ol { display: grid; }

    &::before { content: ''; position: absolute; top: 0; bottom: 0; left: 0; width: 1px; background: var(--border); }

    > b {
      position: absolute;
      top: 0;
      left: 0;
      width: 1px;
      height: var(--h, 8px);
      background: var(--text);
      transition: height 0.4s var(--ease-soft);

      &::after { content: ''; position: absolute; bottom: -4px; left: -3px; width: 7px; height: 7px; background: var(--accent); }
    }
  }

  .tl__i {
    display: grid;
    gap: var(--space-3);
    padding-bottom: calc(var(--cell) * 1.5);

    &:last-child { padding-bottom: 0; } // the line ends with the last entry

    > p { max-width: 48ch; color: var(--muted); }
    .mono { color: var(--text); }
  }

  // Entries ahead of the line wait in --muted (AA), tags faded: colour, not opacity, so contrast holds.
  @include motion {
    .tl__i :is(h3, .mono), .tl__tags li { transition: color var(--duration-base) var(--ease-soft), border-color var(--duration-base) var(--ease-soft); }

    :global(.js) .tl__i:not(:global(.is-on)) {
      :is(h3, .mono) { color: var(--muted); }
      .tl__tags li { border-color: color-mix(in srgb, var(--border) 50%, transparent); }
    }
  }

  .tl__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);

    li {
      padding: var(--space-1) var(--space-2);
      color: var(--muted);
      border: 1px solid var(--border);

      @include text(tag);

      text-transform: uppercase;
    }
  }
</style>
