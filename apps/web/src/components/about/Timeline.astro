---
// Timeline: a sticky year (3 cells on md, 4 on lg) rolls on a live odometer while the entries scroll; the hairline
// is scrubbed by the scroll (ScrollTrigger progress, transforms only, no CSS transition: Lenis already smooths
// it, a transition on top made it lag and stagger) from the list top at the middle of the viewport to the list end
// at the middle, with the pixel at its tip; an entry lights when the tip reaches it. Mobile: the big year is hidden, each entry carries its own (always in the markup).
import Odometer from '@/components/ui/Odometer.astro';
import type { AboutPage } from '@/lib/types';

interface Props { entries: AboutPage['timeline'] }
const { entries } = Astro.props;
---
<div class="tl" data-timeline>
  <div class="tl__y" aria-hidden="true">
    <Odometer value={entries[0].year} live class="tl__odo" />
    <span class="tag" data-title>{entries[0].title}</span>
  </div>
  <div class="tl__list">
    <b aria-hidden="true"></b>
    <i aria-hidden="true"></i>
    <ol role="list">
    {entries.map((e, i) => (
      <li class:list={['tl__i', { 'is-on': i === 0 }]} data-year={e.year} data-title={e.title}>
        <span class="mono">{e.year}</span>
        <h3>{e.title}</h3>
        <p>{e.text}</p>
        {e.tags.length > 0 && <ul role="list" class="tl__tags">{e.tags.map((t) => <li>{t}</li>)}</ul>}
      </li>
    ))}
    </ol>
  </div>
</div>

<script>
  import { ScrollTrigger, reduceMotion } from '@/scripts/gsap';
  import { decode } from '@/scripts/decode';
  import { setOdometer } from '@/scripts/odometer';

  for (const tl of document.querySelectorAll<HTMLElement>('[data-timeline]')) {
    const list = tl.querySelector<HTMLElement>('.tl__list')!;
    const items = [...list.querySelectorAll<HTMLElement>('.tl__i')];
    const fill = list.querySelector<HTMLElement>(':scope > b')!;
    const tip = list.querySelector<HTMLElement>(':scope > i')!;
    const odo = tl.querySelector<HTMLElement>('.tl__odo')!;
    const title = tl.querySelector<HTMLElement>('[data-title]')!;
    let cur = -1;
    const update = (p: number) => {
      // Layout offsets, not rects: no layout read per frame beyond the cached heights.
      const h = list.offsetHeight;
      const y = Math.max(8, p * h);
      fill.style.transform = `scaleY(${y / h})`;
      tip.style.transform = `translateY(${y}px)`;
      let c = 0;
      items.forEach((it, i) => { const on = it.offsetTop <= y; it.classList.toggle('is-on', on || i === 0); if (on) c = i; });
      const last = items[c];
      if (c === cur) return;
      cur = c;
      setOdometer(odo, last.dataset.year!);
      decode(title, last.dataset.title!, 500);
    };
    if (reduceMotion()) items.forEach((it) => it.classList.add('is-on'));
    ScrollTrigger.create({ trigger: list, start: 'top 50%', end: 'bottom 50%', onUpdate: (s) => update(s.progress), onRefresh: (s) => update(s.progress) });
  }
</script>

<style lang="scss">
  .tl {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--cell);

    @include mq(md) { grid-template-columns: calc(var(--cell) * 3) minmax(0, 1fr); }

    @include mq(lg) { grid-template-columns: calc(var(--cell) * 4) minmax(0, 1fr); }
  }

  .tl__y {
    position: sticky;
    top: calc(var(--header-h) + var(--space-6));
    display: none;
    align-self: start;
    gap: var(--space-4);

    @include mq(md) { display: grid; }

    :global(.tl__odo) {
      font-size: clamp(48px, 6vw, 88px); // fits the 3-4 cell column
      letter-spacing: -0.04em;
    }
  }

  // The line: 1px hairline on the left; b = the fill (scaleY from the top), i = the pixel at its tip.
  .tl__list {
    position: relative;
    padding-left: var(--cell);

    > ol { display: grid; }

    &::before { content: ''; position: absolute; top: 0; bottom: 0; left: 0; width: 1px; background: var(--border); }

    > b {
      position: absolute;
      inset: 0 auto 0 0;
      width: 1px;
      background: var(--text);
      transform: scaleY(0);
      transform-origin: top;
    }

    > i { position: absolute; top: -4px; left: -3px; width: 7px; height: 7px; background: var(--accent); }
  }

  // Entry: year, title, text, tags, with room between them (the title sits closer to its year than to the text).
  .tl__i {
    display: grid;
    gap: var(--space-5);
    padding-bottom: calc(var(--cell) * 2);

    &:last-child { padding-bottom: 0; } // the line ends with the last entry

    > h3 { margin-top: calc(var(--space-2) - var(--space-5)); }
    > p { max-width: 64ch; color: var(--muted); }
    .mono { color: var(--text); }
  }

  // Entries ahead of the line wait in --muted (AA), tags faded: colour, not opacity, so contrast holds.
  @include motion {
    .tl__i :is(h3, .mono), .tl__tags li { transition: color var(--duration-base) var(--ease-soft), border-color var(--duration-base) var(--ease-soft); }

    :global(.js) .tl__i:not(:global(.is-on)) {
      :is(h3, .mono) { color: var(--muted); }
      .tl__tags li { border-color: color-mix(in srgb, var(--border) 50%, transparent); }
    }
  }

  .tl__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);

    li {
      padding: var(--space-1) var(--space-2);
      color: var(--muted);
      border: 1px solid var(--border);

      @include text(tag);

      text-transform: uppercase;
    }
  }
</style>
