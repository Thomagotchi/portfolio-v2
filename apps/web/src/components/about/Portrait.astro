---
// Portrait in the notch frame (Window, opens on scroll-in). No photo yet → the dot warp holds the place.
import { Image } from 'astro:assets';
import Window from '@/components/ui/Window.astro';
import { imageUrl } from '@/lib/sanity';
import type { SanityImage } from '@/lib/types';

interface Props { image?: SanityImage; name: string }
const { image, name } = Astro.props;
const src = image ? imageUrl(image, 960) : '';
---
<figure class="pt" data-portrait>
  <Window>
    {src
      ? <Image src={src} alt={image?.alt ?? name} width={800} height={1000} class="pt__img" />
      : <canvas class="pt__cv" aria-hidden="true"></canvas>}
  </Window>
  {!src && <figcaption class="tag pt__cap">Portrait · placeholder</figcaption>}
</figure>

<script>
  import { dotWarp } from '@/scripts/dots';

  for (const f of document.querySelectorAll<HTMLElement>('[data-portrait]')) {
    const cv = f.querySelector('canvas');
    if (cv) dotWarp(cv, f);
  }
</script>

<style lang="scss">
  .pt {
    position: relative;
    width: 100%;
    max-width: 420px;
    margin: 0;
    aspect-ratio: 4 / 5;

    @include mq(lg) { max-width: none; }
  }

  .pt__cv, :global(.pt__img) { display: block; width: 100%; height: 100%; object-fit: cover; }

  .pt__cap {
    position: absolute;
    bottom: var(--space-4);
    left: var(--space-4);
    padding: var(--space-1) var(--space-2);
    background: var(--bg);
    border: 1px solid var(--border);
  }
</style>
