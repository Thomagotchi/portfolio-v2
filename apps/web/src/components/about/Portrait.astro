---
// Portrait in the notch frame (Window, opens on scroll-in). No photo yet → the code relief (DA 3D scene)
// holds the place. On lg it is as tall as the header text beside it; below lg, 4:5.
import { Image } from 'astro:assets';
import Window from '@/components/ui/Window.astro';
import { imageUrl } from '@/lib/sanity';
import type { SanityImage } from '@/lib/types';
import { useT } from '@/i18n';

interface Props { image?: SanityImage; name: string }
const { image, name } = Astro.props;
const src = image ? imageUrl(image, 960) : '';
---
<figure class="pt" data-portrait>
  <Window>
    {src
      ? <Image src={src} alt={image?.alt ?? name} width={800} height={1000} class="pt__img" />
      : <div class="pt__scene" data-relief aria-hidden="true"></div>}
  </Window>
  {!src && <figcaption class="tag pt__cap">{useT(Astro.currentLocale).about.portrait}</figcaption>}
</figure>

<script>
  import { mountRelief } from '@/scripts/three/load';

  for (const f of document.querySelectorAll<HTMLElement>('[data-portrait]')) {
    const host = f.querySelector<HTMLElement>('[data-relief]');
    if (host) mountRelief(host, { pointer: f });
  }
</script>

<style lang="scss">
  .pt {
    position: relative;
    width: 100%;
    max-width: 420px;
    min-height: 360px;
    margin: 0;
    aspect-ratio: 4 / 5;

    @include mq(lg) {
      max-width: none;
      height: 100%;
      aspect-ratio: auto;
    }
  }

  .pt__scene, :global(.pt__img) { display: block; width: 100%; height: 100%; object-fit: cover; }

  .pt__scene :global(canvas) {
    display: block;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity var(--duration-fade-in) var(--ease-soft);
  }

  .pt__scene:global(.is-ready) :global(canvas) { opacity: 1; }

  .pt__cap {
    position: absolute;
    bottom: var(--space-4);
    left: var(--space-4);
    padding: var(--space-1) var(--space-2);
    background: var(--bg);
    border: 1px solid var(--border);
  }
</style>
