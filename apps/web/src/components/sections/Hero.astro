---
// Window open (ui/Window, at first paint) into a 1px frame on the frame line. Home (code field): the hero then
// builds itself (scripts/build: outlines, skeleton bars, the text uncovered behind an accent caret), and the code
// field (scripts/codefield: this file's own source, drifting down) fades in beside the text once it is built;
// hovering a part of the hero scrolls the code to the lines that render it. Other pages: the text rises out of
// a mask. Text is painted from the first frame either way (LCP). The hero is exactly one viewport; the title
// scales with width and height so the block always fits inside the frame.
// Slots (inner pages, e.g. About): "scene" replaces the code field inside the window; the default slot rises
// after the text (meta cells).
import Button from '@/components/ui/Button.astro';
import Headline from '@/components/ui/Headline.astro';
import Window from '@/components/ui/Window.astro';
import type { HeroBlock } from '@/lib/types';

interface Props { block: HeroBlock; first?: boolean }
const { block, first } = Astro.props; // label: a wrap never starts a line with its ' · ' separator
---
<section class="hero" data-hero data-build={!Astro.slots.has('scene') && block.scene ? '' : undefined}>
  <Window mode="load">
    {Astro.slots.has('scene')
      ? <div class="hero__field"><slot name="scene" /></div>
      : block.scene && <div class="hero__field" data-code="side" aria-hidden="true"></div>}
  </Window>
  <div class="wrap hero__content">
    {block.label && <div class="rise"><p class="tag">{block.label.replaceAll(' · ', '\u00a0· ')}</p></div>}
    <div class="rise"><Headline heading={block.heading} as={first ? 'h1' : 'h2'} class="hero__title" /></div>
    {block.text && <div class="rise"><p class="lede">{block.text}</p></div>}
    {block.ctas?.length ? (
      <div class="rise"><div class="hero__ctas">
        {block.ctas.map((c) => <Button href={c.href} variant={c.variant} size="md" lgSize="lg">{c.label}</Button>)}
      </div></div>
    ) : null}
    {Astro.slots.has('default') && <div class="rise hero__more"><div><slot /></div></div>}
  </div>
</section>

<script>
  import { mountCode } from '@/scripts/three/load';
  import { build } from '@/scripts/build';

  const host = document.querySelector<HTMLElement>('[data-hero] [data-code]');
  // Built first, then the code field fades in; each part of the hero is tied to the lines that render it.
  if (host) {
    const hero = host.closest<HTMLElement>('[data-hero]')!, text = hero.querySelector<HTMLElement>('.hero__content');
    const part = (sel: string) => text?.querySelector<HTMLElement>(sel)?.parentElement;
    const targets = [
      { el: part('.tag'), from: 'class="tag"' },
      { el: part('.hero__title'), from: '<Headline' },
      { el: part('.lede'), from: 'class="lede"' },
      { el: part('.hero__ctas'), from: 'hero__ctas', to: ') : null}' },
    ].filter((t): t is { el: HTMLElement; from: string; to?: string } => !!t.el);
    build(hero).finally(() => mountCode(host, { text, targets, fill: host.dataset.code === 'full' ? 'full' : 'side' }));
  }
</script>

<style lang="scss">
  // One viewport. Content sits low in the frame, inset from it on every side (min-height: never clips it).
  .hero {
    --duration-hero: 1.1s; // the window opens quicker here: the build follows it
    --pad: clamp(24px, 7svh, 88px);
    --win-inset: var(--frame);
    --rise-at: calc(var(--duration-hero) + 0.1s); // content rises once the window has opened, never during

    position: relative;
    isolation: isolate;
    display: grid;
    align-content: end;
    min-height: calc(100svh - var(--header-h));
    padding-block: calc(var(--frame) + var(--pad));
  }

  .hero__field {
    position: absolute;
    inset: 0;

    // Code field: fades in once ready. A slotted scene brings its own entrance.
    &[data-code] :global(canvas) {
      display: block;
      width: 100%;
      height: 100%;
      opacity: 0;
      transition: opacity var(--duration-fade-in) var(--ease-soft) var(--delay, 0s);
    }

    &[data-code]:global(.is-ready canvas) { opacity: 1; }
  }

  .hero__content {
    position: relative;
    display: grid;
    justify-items: start;
    gap: var(--space-head);
    padding-inline: max(calc(var(--margin) + var(--tx)), calc(var(--frame) + var(--space-5))) max(var(--margin), calc(var(--frame) + var(--space-5)));

    // Display size: the h1 token's range, held down so the code field gets the room (and on short screens).
    :global(.hero__title) {
      max-width: 10.5em;
      font-size: clamp(34px, min(5.2vw, 8svh), 76px);
    }
  }

  // Build (home): each block is masked away from the left (a mask, not a clip: the masked text still counts as
  // painted, so the LCP is the first frame; measured, a clip-path or a transparent colour moves it to the reveal)
  // and scripts/build uncovers it (--rv) while it draws the skeleton. No box is drawn over the text. The mask
  // spans the whole block, padding included (the CTAs' edges sit in it). Without JS --rv runs to 1 by
  // itself once the window has opened; under reduced motion there is no mask (and nothing rises).
  .hero[data-build] :global(.rise) > :global(*) { animation: none; }

  @include motion {
    .hero[data-build] :global(.rise) {
      mask-image: linear-gradient(90deg, var(--color-ink-950) calc(var(--rv) * 100%), transparent 0); // any opaque colour: only the alpha counts
      animation: unveil var(--duration-slow) var(--ease-move) calc(var(--rise-at) + 1s) both;
    }

    .hero[data-build]:global(.is-building .rise) { animation: none; }
  }

  .hero :global(.hero__build) {
    position: absolute;
    inset: 0;
    z-index: 1;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  .hero__more {
    justify-self: stretch;
    margin-top: var(--space-block);
  }

  .lede { margin-top: var(--space-2); text-wrap: balance; }

  .hero__ctas {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-4);
    margin-top: var(--space-block);
    margin-left: calc(var(--tx) * -1);

    @include mq(md) { flex-flow: row wrap; }
  }

  @property --rv { syntax: '<number>'; inherits: true; initial-value: 0; }

  @keyframes unveil { to { --rv: 1; } }
</style>
