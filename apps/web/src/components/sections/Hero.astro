---
// Window open (ui/Window, at first paint) into a 1px frame on the frame line, the text rises out of a mask, the dot terrain fades in inside the frame.
// All CSS at first paint: JS only loads the terrain. The hero is exactly one viewport; the title scales with
// width and height so the block always fits inside the frame. The whole section feeds the terrain's pointer.
import Button from '@/components/ui/Button.astro';
import Headline from '@/components/ui/Headline.astro';
import Window from '@/components/ui/Window.astro';
import type { HeroBlock } from '@/lib/types';

interface Props { block: HeroBlock; first?: boolean }
const { block, first } = Astro.props;
---
<section class="hero" data-hero>
  <Window mode="load">{block.scene && <div class="hero__field" data-terrain aria-hidden="true"></div>}</Window>
  <div class="wrap hero__content">
    {block.label && <div class="rise"><p class="tag">{block.label}</p></div>}
    <div class="rise"><Headline heading={block.heading} as={first ? 'h1' : 'h2'} class="hero__title" /></div>
    {block.text && <div class="rise"><p class="lede">{block.text}</p></div>}
    {block.ctas?.length ? (
      <div class="rise"><div class="hero__ctas">
        {block.ctas.map((c) => <Button href={c.href} variant={c.variant} size="md" lgSize="lg">{c.label}</Button>)}
      </div></div>
    ) : null}
  </div>
</section>

<script>
  import { mountTerrain } from '@/scripts/three/load';

  const host = document.querySelector<HTMLElement>('[data-hero] [data-terrain]');
  // Fades in 2.6 s after navigation (the window has opened), whatever time the script arrives.
  if (host) {
    mountTerrain(host, {
      density: [[100, 76], [120, 72], [180, 96]],
      pointer: host.closest<HTMLElement>('[data-hero]')!,
      delay: Math.max(0, 2600 - performance.now()),
    });
  }
</script>

<style lang="scss">
  // One viewport. Content sits low in the frame, inset from it on every side (min-height: never clips it).
  .hero {
    --pad: clamp(24px, 7svh, 88px);
    --win-inset: var(--frame);

    position: relative;
    isolation: isolate;
    display: grid;
    align-content: end;
    min-height: calc(100svh - var(--header-h));
    padding-block: calc(var(--frame) + var(--pad));
  }

  .hero__field {
    position: absolute;
    inset: 0;

    :global(canvas) {
      display: block;
      width: 100%;
      height: 100%;
      opacity: 0;
      transition: opacity var(--duration-fade-in) var(--ease-soft) var(--delay, 0s);
    }

    &:global(.is-ready canvas) { opacity: 0.85; }
  }

  .hero__content {
    position: relative;
    display: grid;
    justify-items: start;
    gap: var(--space-head);
    padding-inline: max(calc(var(--margin) + var(--tx)), calc(var(--frame) + var(--space-5))) max(var(--margin), calc(var(--frame) + var(--space-5)));

    // Display size: the h1 token's range, pushed up to fill wide screens, held down on short ones.
    :global(.hero__title) {
      max-width: 10.5em;
      font-size: clamp(38px, min(7vw, 10.5svh), 100px);
    }
  }
  .lede { margin-top: var(--space-2); }

  .hero__ctas {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-4);
    margin-top: var(--space-block);
    margin-left: calc(var(--tx) * -1);

    @include mq(md) { flex-flow: row wrap; }
  }
</style>
