---
// Tools: tag and heading, then one card per tool in a grid of shared hairlines (every card fully framed).
// Cursor brackets on the grid (scripts/brackets.ts); the cards rise in on enter.
import Headline from '@/components/ui/Headline.astro';
import Seam from '@/components/ui/Seam.astro';
import Tag from '@/components/ui/Tag.astro';
import type { StackBlock } from '@/lib/types';

interface Props { block: StackBlock }
const { block } = Astro.props;
const id = `${block._key}-h`;
---
<section class="section stk" aria-labelledby={id}>
  <Seam />
  <div class="wrap stk__in">
    <div class="stk__head">
      {block.label && <Tag>{block.label}</Tag>}
      <Headline heading={block.heading} id={id} />
    </div>
    <ul role="list" class="stk__grid" data-inview data-brackets>
      {block.tools.map((t, i) => <li style={`--d:${i * 0.06}s`}>{t}</li>)}
    </ul>
  </div>
</section>

<style lang="scss">
  .stk__in {
    display: grid;
    gap: var(--space-block);
  }

  .stk__head {
    display: grid;
    gap: var(--space-head);
  }

  .stk__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin-left: calc(var(--tx) * -1);
    border-top: 1px solid var(--border);
    border-left: 1px solid var(--border);

    @include mq(md) { grid-template-columns: repeat(4, minmax(0, 1fr)); }

    li {
      display: grid;
      place-items: center;
      min-height: 96px;
      padding: var(--space-4);
      border-right: 1px solid var(--border);
      border-bottom: 1px solid var(--border);
      text-align: center;

      @include text(h3);

      @include mq(md) { min-height: 128px; }
    }
  }

  @include motion {
    .stk__grid li { transition: opacity 1s var(--ease-soft) var(--d), translate 1s var(--ease-soft) var(--d); }

    :global(.js) .stk__grid:not(:global(.is-in)) li { opacity: 0; translate: 0 12px; }
  }
</style>
