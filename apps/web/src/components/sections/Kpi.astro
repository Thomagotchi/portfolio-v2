---
// Square-cell grid band: lines draw in, then tag and heading; each stat cell opens like the site's window (an
// accent line draws along its top, the cell opens down from it, its pixel in the corner), one after the other, and
// its figure rolls in. Triggered once when the band scrolls in.
// The page grid: lines on the frame (the thread rides one) and on the margin, where the title, the text of
// every section and the stat row start. Stats in one row of equal columns, margin line to margin line. Baselines sit on the horizontal lines (text-box trim + rows of one cell).
import Headline from '@/components/ui/Headline.astro';
import Odometer from '@/components/ui/Odometer.astro';
import Seam from '@/components/ui/Seam.astro';
import Tag from '@/components/ui/Tag.astro';
import type { KpiBlock } from '@/lib/types';

interface Props { block: KpiBlock; lk?: Record<string, string | undefined> }
const { block, lk } = Astro.props;
---
<section class="kpi" data-inview data-start="top 85%" style={`--k:${block.stats.length}`} aria-labelledby={`${block._key}-h`} {...lk}>
  <Seam />
  <div class="kpi__grid" aria-hidden="true"></div>
  <div class="wrap kpi__in">
    {block.label && <Tag class="kpi__tag">{block.label}</Tag>}
    <Headline heading={block.heading} class="kpi__h" id={`${block._key}-h`} />
  </div>
  <div class="wrap">
    <ul role="list" class="kpi__cells" data-brackets>
      {block.stats.map((s, i) => (
        <li style={`--w:${i}`}><div class="kpi__w"><Odometer value={s.value} /><span class="small muted">{s.label}</span></div></li>
      ))}
    </ul>
  </div>
</section>

<style lang="scss">
  // The stat row runs from the margin line, like the title and every section's text, to the right margin.
  .kpi {
    --kx: var(--margin);

    position: relative;
    padding-block: calc(var(--cell) * 2);

    // Mobile: 9 cells across the content, lines on both margins (the frame and thread ride the left one); the stats stack.
    @media (width < 768px) { --cell: calc((100vw - 2 * var(--margin)) / 9); }
  }

  .kpi__grid {
    position: absolute;
    inset: 0;
    pointer-events: none;

    @include fade-edges(calc(var(--cell) * 2));

    &::before, &::after {
      content: '';
      position: absolute;
      inset: 0;
    }

    &::before { @include hairlines(true, false); }
    &::after { @include hairlines(false, true); }
  }

  .wrap { position: relative; }

  .kpi__in {
    display: grid;
    grid-auto-rows: var(--cell);
    align-items: end;
  }

  // Tag and heading are child components: their classes need :global (no scope attribute on them).
  .kpi__in > :global(.kpi__tag), .kpi__in > :global(.kpi__h) { text-box: trim-both cap alphabetic; }
  .kpi__in > :global(.kpi__h) { grid-row: span 2; max-width: 16ch; }

  .kpi__cells {
    display: grid;
    grid-template-columns: minmax(0, 1fr);

    // Stacked on mobile (one-line caption): 3 cells per stat.
    grid-auto-rows: calc(var(--cell) * 3);
    margin-top: var(--cell);
    margin-left: calc(var(--kx) - var(--margin) - var(--tx));

    // One row: at least ~150px tall (figure + a two-line caption), rounded up to whole cells so rows still end on lines.
    @include mq(md) {
      grid-template-columns: repeat(var(--k, 3), minmax(0, 1fr));
      grid-auto-rows: round(up, max(calc(var(--cell) * 3), 9.5rem), var(--cell));
    }

    // Each stat is a window: the li holds the opening line, .kpi__w the frame (its borders overlap the
    // neighbours' by 1px, so the row reads as one hairline grid), the figure at the top, the caption on the bottom
    // edge (captions line up across the row whatever their length), the pixel in the corner.
    li { position: relative; margin: 0 -1px -1px 0; }

    li::before {
      content: '';
      position: absolute;
      inset: 0 0 auto;
      z-index: 1;
      height: 1px;
      background: var(--accent);
      transform: scaleX(0);
      transform-origin: left;
    }
  }

  .kpi__w {
    position: relative;
    display: grid;
    align-content: space-between;
    gap: var(--space-2);
    height: 100%;
    padding: var(--space-3);
    overflow-wrap: anywhere;
    background: var(--bg);
    border: 1px solid var(--border);

    @include mq(md) { gap: min(calc(var(--cell) / 2), var(--space-4)); padding: min(calc(var(--cell) / 2), var(--space-5)); }

    &::before {
      content: '';
      position: absolute;
      top: -1px;
      left: -1px;
      width: 7px;
      height: 7px;
      background: var(--accent);
    }
  }

  @include motion {
    .kpi__grid::before { transition: clip-path 1.6s var(--ease-soft) 0.2s; }
    .kpi__grid::after { transition: clip-path 1.3s var(--ease-move) 0.3s; }

    .kpi__in > :global(.kpi__h) { transition: opacity 0.8s var(--ease-soft) 0.15s, translate var(--duration-slow) var(--ease-move) 0.15s; }

    // Window i: its line draws at --at, the cell opens from it 0.2s later (the line fades as it does), the figure
    // rolls once it is open.
    .kpi__cells li {
      --at: calc(0.3s + var(--w) * 0.15s);
      --odo-at: calc(var(--at) + 0.35s);
      --odo-dur: 1s;

      &::before { transition: transform 0.3s var(--ease-move) var(--at), opacity 0.3s var(--ease-soft) calc(var(--at) + 0.55s); }
    }

    .kpi__w { clip-path: inset(-8px); transition: clip-path 0.45s var(--ease-move) calc(var(--at) + 0.2s); } // -8px: room for the pixel

    .kpi:global(.is-in) .kpi__cells li::before { transform: scaleX(1); opacity: 0; }

    :global(.js) .kpi:not(:global(.is-in)) {
      .kpi__grid::before { clip-path: inset(0 0 100% 0); }
      .kpi__grid::after { clip-path: inset(0 100% 0 0); }
      .kpi__in > :global(.kpi__h) { opacity: 0; translate: 0 12px; }
      .kpi__w { clip-path: inset(-8px -8px 100%); }
    }
  }
</style>
