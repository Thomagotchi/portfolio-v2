---
// Square-cell grid band: lines draw in, then tag, heading and the stat cells; figures roll in.
// The page grid: lines on the frame (the thread rides one) and on the margin, where the title, the text of
// every section and the stat row start. Stats in one row of equal columns, margin line to margin line. Baselines sit on the horizontal lines (text-box trim + rows of one cell).
import Headline from '@/components/ui/Headline.astro';
import Odometer from '@/components/ui/Odometer.astro';
import Seam from '@/components/ui/Seam.astro';
import Tag from '@/components/ui/Tag.astro';
import type { KpiBlock } from '@/lib/types';

interface Props { block: KpiBlock }
const { block } = Astro.props;
---
<section class="kpi" data-inview style={`--k:${block.stats.length}`} aria-labelledby={`${block._key}-h`}>
  <Seam />
  <div class="kpi__grid" aria-hidden="true"></div>
  <div class="wrap kpi__in">
    {block.label && <Tag class="kpi__tag">{block.label}</Tag>}
    <Headline heading={block.heading} class="kpi__h" id={`${block._key}-h`} />
  </div>
  <div class="wrap">
    <ul role="list" class="kpi__cells" data-brackets>
      {block.stats.map((s) => (
        <li><Odometer value={s.value} /><span class="small muted">{s.label}</span></li>
      ))}
    </ul>
  </div>
</section>

<style lang="scss">
  // The stat row runs from the margin line, like the title and every section's text, to the right margin.
  .kpi {
    --kx: var(--margin);

    position: relative;
    padding-block: calc(var(--cell) * 2);

    // Mobile: 9 cells across the content, lines on both margins (the frame and thread ride the left one); the stats stack.
    @media (width < 768px) { --cell: calc((100vw - 2 * var(--margin)) / 9); }
  }

  .kpi__grid {
    position: absolute;
    inset: 0;
    pointer-events: none;

    @include fade-edges(calc(var(--cell) * 2));

    &::before, &::after {
      content: '';
      position: absolute;
      inset: 0;
    }

    &::before { @include hairlines(true, false); }
    &::after { @include hairlines(false, true); }
  }

  .wrap { position: relative; }

  .kpi__in {
    display: grid;
    grid-auto-rows: var(--cell);
    align-items: end;
  }

  // Tag and heading are child components: their classes need :global (no scope attribute on them).
  .kpi__in > :global(.kpi__tag), .kpi__in > :global(.kpi__h) { text-box: trim-both cap alphabetic; }
  .kpi__in > :global(.kpi__h) { grid-row: span 2; max-width: 16ch; }

  .kpi__cells {
    display: grid;
    grid-template-columns: minmax(0, 1fr);

    // Stacked on mobile (one-line caption): 3 cells per stat.
    grid-auto-rows: calc(var(--cell) * 3);
    margin-top: var(--cell);
    margin-left: calc(var(--kx) - var(--margin) - var(--tx));
    border-top: 1px solid var(--border);
    border-left: 1px solid var(--border);

    // One row: at least ~150px tall (figure + a two-line caption), rounded up to whole cells so rows still end on lines.
    @include mq(md) {
      grid-template-columns: repeat(var(--k, 3), minmax(0, 1fr));
      grid-auto-rows: round(up, max(calc(var(--cell) * 3), 9.5rem), var(--cell));
    }

    // Figure at the top, caption on the bottom edge: captions line up across the row whatever their length.
    li {
      display: grid;
      align-content: space-between;
      gap: var(--space-2);
      padding: var(--space-3);
      overflow-wrap: anywhere;

      @include mq(md) { gap: min(calc(var(--cell) / 2), var(--space-4)); padding: min(calc(var(--cell) / 2), var(--space-5)); }

      background: var(--bg);
      border-right: 1px solid var(--border);
      border-bottom: 1px solid var(--border);
    }
  }

  @include motion {
    .kpi__grid::before { transition: clip-path 1.6s var(--ease-soft) 0.2s; }
    .kpi__grid::after { transition: clip-path 1.3s var(--ease-move) 0.3s; }

    .kpi__in > :global(.kpi__h), .kpi__cells { transition: opacity 1s var(--ease-soft) 1.05s, translate var(--duration-slow) var(--ease-move) 1.05s; }
    .kpi__cells { transition-delay: 1.2s; }

    :global(.js) .kpi:not(:global(.is-in)) {
      .kpi__grid::before { clip-path: inset(0 0 100% 0); }
      .kpi__grid::after { clip-path: inset(0 100% 0 0); }
      .kpi__in > :global(.kpi__h), .kpi__cells { opacity: 0; translate: 0 12px; }
    }
  }
</style>
