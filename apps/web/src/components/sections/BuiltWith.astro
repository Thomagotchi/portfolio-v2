---
// Slim band: section tag then bracket-framed names that close in on enter.
import Bracket from '@/components/ui/Bracket.astro';
import Seam from '@/components/ui/Seam.astro';
import Tag from '@/components/ui/Tag.astro';
import type { BuiltWithBlock } from '@/lib/types';

interface Props { block: BuiltWithBlock }
const { block } = Astro.props;
---
<section class="bw" data-inview aria-label={block.label}>
  <Seam />
  <div class="wrap bw__in">
    <Tag>{block.label}</Tag>
    <ul role="list" class="bw__list">
      {block.items.map((t) => <li><Bracket>{t}</Bracket></li>)}
    </ul>
  </div>
</section>

<style lang="scss">
  .bw {
    position: relative;
    padding-block: var(--space-band);
  }

  .bw__in {
    display: grid;
    gap: var(--space-5);

    @include mq(md) {
      grid-template-columns: auto 1fr;
      align-items: center;
      column-gap: calc(var(--cell) * 2);
    }
  }

  .bw__list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-3);

    @include mq(md) { grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--space-5); }
  }
</style>
