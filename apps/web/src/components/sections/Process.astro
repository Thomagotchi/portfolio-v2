---
// Process: the steps of a project, one line each. Switches (design, copy, care…) fold away the steps that
// depend on them; the numbering follows (CSS counter on the steps still in). The pricing button opens the
// simulator with the same options set. Without JS: every step shows, no switches.
// Large screens with motion: the section pins and plays as one big animation instead: a giant number rolls
// 01 → n as you scroll, the current step's title beside it, a tick per step. The list stays for screen readers.
import Button from '@/components/ui/Button.astro';
import Seam from '@/components/ui/Seam.astro';
import Headline from '@/components/ui/Headline.astro';
import Tag from '@/components/ui/Tag.astro';
import Switch from '@/components/form/Switch.astro';
import { langOf, localize } from '@/i18n';
import type { ProcessBlock } from '@/lib/types';

interface Props { block: ProcessBlock; lk?: Record<string, string | undefined> }
const { block, lk } = Astro.props;
const id = `${block._key}-h`;
const pricing = localize('/pricing', langOf(Astro.currentLocale));
---
<section class="section pc" id={block.anchor} aria-labelledby={id} data-process data-pricing={pricing} {...lk}>
  <Seam />
  <div class="wrap pc__in">
    <div class="pc__track" data-track>
    <div class="pc__body">
      <div class="pc__side">
        <div class="pc__head">
          {block.label && <Tag>{block.label}</Tag>}
          <Headline heading={block.heading} id={id} />
        </div>
        {block.toggles?.length ? (
          <fieldset class="pc__tg" data-map={JSON.stringify(Object.fromEntries(block.toggles.map((t) => [t.key, { opt: t.opt, care: t.care }])))}>
            {block.togglesLabel && <legend class="tag">{block.togglesLabel}</legend>}
            {block.toggles.map((t) => <Switch name="inc" value={t.key} label={t.label} checked />)}
          </fieldset>
        ) : null}
      </div>
      <ol role="list" class="pc__steps" data-inview data-start="top 80%">
        {block.steps.map((s, i) => (
          <li class="pc__s" data-when={s.when || undefined} style={`--d:${i * 0.06}s`}>
            <div class="pc__fold"><div class="pc__row"><span class="pc__n" aria-hidden="true"></span><h3 class="pc__t">{s.title}</h3></div></div>
          </li>
        ))}
      </ol>
      <div class="pc__big" aria-hidden="true" data-big>
        <div class="pc__num">{['t', 'u'].map((r) => <span class="pc__reel" data-reel={r}>{Array.from({ length: 11 }, (_, d) => <b>{d % 10}</b>)}</span>)}</div>
        <div class="pc__now"><div class="pc__clip"><p data-now></p></div><span class="pc__of mono" data-of></span></div>
        <div class="pc__ticks" data-ticks></div>
      </div>
    </div>
    </div>
    {block.ctas?.length ? (
      <div class="pc__ctas">{block.ctas.map((c) => <Button href={c.href} variant={c.variant}>{c.label}</Button>)}</div>
    ) : null}
  </div>
</section>

<script>
  import { ScrollTrigger, reduceMotion } from '@/scripts/gsap';

  for (const pc of document.querySelectorAll<HTMLElement>('[data-process]')) {
    const boxes = [...pc.querySelectorAll<HTMLInputElement>('[name="inc"]')];
    const steps = [...pc.querySelectorAll<HTMLElement>('[data-when]')];
    const sim = [...pc.querySelectorAll<HTMLAnchorElement>(`a[href^="${pc.dataset.pricing}"]`)];
    const base = sim.map((a) => a.getAttribute('href')!.split(/[?#]/)[0]);
    const map = JSON.parse(pc.querySelector<HTMLElement>('[data-map]')?.dataset.map ?? '{}') as Record<string, { opt?: number; care?: number }>;

    const apply = () => {
      const on = new Set(boxes.filter((b) => b.checked).map((b) => b.value));
      for (const s of steps) {
        const off = !on.has(s.dataset.when!);
        s.classList.toggle('is-off', off);
        s.inert = off; // folded steps leave the reading order too
      }
      // Simulator preset: the options and care plan these switches stand for (indices in the pricing document).
      const opt: number[] = [];
      let care = 0;
      for (const k of on) {
        const m = map[k];
        if (m?.opt != null) opt.push(m.opt);
        if (m?.care != null) care = m.care;
      }
      const q = new URLSearchParams({ opt: opt.join(','), care: String(care) }).toString();
      sim.forEach((a, i) => (a.href = `${base[i]}?${q}#simulator`));
    };
    pc.addEventListener('change', () => { apply(); big?.(); });
    apply();
    const big = play(pc);
    big?.();
  }

  // The big animation (lg, motion): progress through the track picks the current step among those still in.
  function play(pc: HTMLElement) {
    if (reduceMotion() || !matchMedia('(min-width: 1024px)').matches) return undefined;
    const track = pc.querySelector<HTMLElement>('[data-track]')!;
    const all = [...pc.querySelectorAll<HTMLElement>('.pc__s')];
    const [tens, units] = [...pc.querySelectorAll<HTMLElement>('[data-reel]')];
    const now = pc.querySelector<HTMLElement>('[data-now]')!, of = pc.querySelector<HTMLElement>('[data-of]')!, ticks = pc.querySelector<HTMLElement>('[data-ticks]')!;
    pc.classList.add('is-big');
    // The track's length counts every step, on or off: a switch never changes the page's height, so toggling
    // one doesn't move the page under the reader (the steps still in share the same length).
    track.style.setProperty('--n', String(all.length));
    let on: HTMLElement[] = [], cur = -1;
    // Text, count and ticks: the step the scroll is in.
    const show = (i: number) => {
      if (i === cur) return;
      cur = i;
      const n = i + 1;
      now.textContent = on[i]?.querySelector('.pc__t')?.textContent ?? '';
      now.classList.remove('is-in'); void now.offsetWidth; now.classList.add('is-in');
      of.textContent = `${String(n).padStart(2, '0')} / ${String(on.length).padStart(2, '0')}`;
      [...ticks.children].forEach((t, k) => t.classList.toggle('on', k <= i));
    };
    // The reels are scrubbed, an odometer on the scroll: each step holds its number, and in its last 30 % the
    // number rolls to the next one. However fast the scroll, the reels sit where the scroll is (never stuck behind
    // it) and every digit rolls past (none skipped). The units reel ends on a second 0 so 9 → 10 rolls forward; the
    // tens reel turns during the units' last tenth.
    const set = (v: number) => {
      units.style.setProperty('--v', String(v % 10));
      tens.style.setProperty('--v', String(Math.floor(v / 10) + Math.max(0, (v % 10) - 9)));
    };
    let v = 1;
    const roll = (p: number) => {
      const n = on.length, x = Math.min(n - 1e-6, Math.max(0, p * n)), i = Math.floor(x);
      const f = x - i, r = i < n - 1 ? 1 - (1 - Math.min(1, Math.max(0, (f - 0.7) / 0.3))) ** 3 : 0;
      v = i + 1 + r;
      set(v);
      show(i);
    };
    // When the scroll stops mid-roll, the number settles on the nearest step (the reels ease there).
    const settle = () => { if (!st.isActive) return; const n = Math.round(v); if (n !== v) { set(n); show(n - 1); } };
    // Counting starts once the section is pinned (its top under the header) and has held step 01 for 40 % of a
    // screen: the reader sees the section settle before anything moves (the track is 40svh longer for it).
    const headerH = () => parseFloat(getComputedStyle(document.documentElement).getPropertyValue('--header-h')) || 64;
    const st = ScrollTrigger.create({
      trigger: track, start: () => `top+=${innerHeight * 0.4} ${headerH()}px`, end: 'bottom bottom', invalidateOnRefresh: true,
      onUpdate: (s) => roll(s.progress),
    });
    addEventListener('load', () => ScrollTrigger.refresh(), { once: true }); // late layout shifts above (images, fonts)
    ScrollTrigger.addEventListener('scrollEnd', settle);
    return () => {
      on = all.filter((s) => !s.classList.contains('is-off'));
      ticks.replaceChildren(...on.map(() => document.createElement('i')));
      cur = -1;
      roll(st.progress);
    };
  }
</script>

<style lang="scss">
  .pc__in {
    display: grid;
    gap: var(--space-block);
  }

  // Side and steps share one grid of their own: the sticky side is bounded by it, so it stops level with
  // the last step (however many there are), never over the buttons below.
  .pc__body {
    display: grid;
    gap: var(--space-block) calc(var(--cell) * 2);

    @include mq(lg) { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); align-items: start; }
  }

  .pc__side {
    display: grid;
    gap: var(--space-block);

    @include mq(lg) { position: sticky; top: calc(var(--header-h) + var(--space-block)); }
  }

  .pc__head {
    display: grid;
    gap: var(--space-head);
  }

  // Compact switches: the legend, then the switches in one wrapping row (the Switch rows lose their
  // hairline and padding here; they keep the 44px touch height).
  .pc__tg {
    display: none;
    flex-wrap: wrap;
    gap: 0 var(--space-6);
    margin: 0;
    padding: 0;
    border: 0;

    legend { float: left; width: 100%; padding-bottom: var(--space-2); color: var(--muted); }

    :global(.op) { padding-block: 0; border: 0; gap: var(--space-3); }
  }

  :global(.js) .pc__tg { display: flex; }

  .pc__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
  }

  // Steps: number · title on hairlines (the offers index look).
  .pc__steps {
    counter-reset: step;
    border-bottom: 1px solid var(--border);
  }

  .pc__s {
    display: grid;
    grid-template-rows: 1fr;
    counter-increment: step;

    &:global(.is-off) { grid-template-rows: 0fr; counter-increment: none; }
  }

  .pc__fold { min-height: 0; overflow: clip; }

  .pc__row {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr); // mobile: the number takes its own width, the title the rest
    align-items: baseline;
    gap: var(--space-3);

    @include mq(md) { grid-template-columns: 4em minmax(0, 1fr); gap: var(--space-4); }

    padding-block: var(--space-4);
    border-top: 1px solid var(--border);
    transition: opacity var(--duration-base) var(--ease-soft);

    :global(.is-off) & { opacity: 0; }
  }

  .pc__n {
    @include text(mono);

    color: var(--muted);

    &::before { content: counter(step, decimal-leading-zero); }
  }

  .pc__t { @include text(title); }

  // The big animation: the track gives the scroll length (a screen, then 40 % of one per step), the body
  // pins under the header and centres. The list is kept for screen readers only.
  .pc__big { display: none; }

  :global(.is-big) {
    // A screen, the 40svh hold on 01, then 40svh per step.
    .pc__track { height: calc(140svh + var(--n, 6) * 40svh); }

    .pc__body {
      position: sticky;
      top: var(--header-h);
      height: calc(100svh - var(--header-h));
      align-content: center;
      align-items: center;
    }

    .pc__side { position: static; }

    .pc__steps {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }

    .pc__big {
      display: grid;
      gap: var(--space-5);
    }
  }

  .pc__num {
    display: flex;
    height: 0.82em;
    overflow: hidden;
    font-size: clamp(180px, 21vw, 340px);
    font-weight: 500;
    font-variant-numeric: tabular-nums;
    line-height: 0.82;
    letter-spacing: -0.06em;
  }

  .pc__reel {
    display: grid;
    translate: 0 calc(var(--v, 0) * -0.82em);
    transition: translate 0.3s var(--ease-move); // short: smooths the scrub and the settle, never lags behind

    b { height: 0.82em; font-weight: inherit; }
  }

  .pc__now {
    display: grid;
    gap: var(--space-2);
    min-height: 2.6em;

    p {
      margin: 0;

      @include text(h3);
    }

    :global(.is-in) { animation: rise var(--duration-slow) var(--ease-move) both; }
  }

  // The title rises inside its own clip, never over the count and ticks below it.
  .pc__clip { overflow: clip; padding-bottom: 0.12em; }

  .pc__of { color: var(--muted); }

  .pc__ticks {
    display: flex;
    gap: var(--space-2);

    :global(i) {
      flex: 1;
      height: 2px;
      background: var(--border);
      transition: background-color 0.4s var(--ease-soft);
    }

    :global(i.on) { background: var(--accent); }
  }

  @include motion {
    .pc__s { transition: grid-template-rows var(--duration-base) var(--ease-move), opacity 1s var(--ease-soft) var(--d), translate 1s var(--ease-soft) var(--d); }

    :global(.js) .pc__steps:not(:global(.is-in)) .pc__s { opacity: 0; translate: 0 12px; }
  }
</style>
