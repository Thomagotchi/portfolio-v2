---
// Chapters with a sticky index (lg+): the rail fills with the scroll, continuously, from the chapters' top
// reaching the middle of the screen to the end of the content (the slot included) reaching it; the pixel
// rides its tip. The chapter whose top passed the middle is current (its label lights); labels scroll to
// their chapter. Under lg the index is hidden and a 2px bar under the navbar shows the same progress. The slot (quote, gallery)
// follows the chapters in the same column. shots: one image after each chapter but the last (its own ratio; a 16:10
// placeholder when the slot is empty),
// opening from a slight inset as it scrolls in.
import { PortableText } from 'astro-portabletext';
import Figure from './Figure.astro';
import Headline from '@/components/ui/Headline.astro';
import Tag from '@/components/ui/Tag.astro';
import WorkImage from '@/components/ui/WorkImage.astro';
import type { Chapter, Shot, TeamLine } from '@/lib/types';
import { byRole } from '@/lib/roles';

import { TAG, langOf, useT } from '@/i18n';

interface Props { chapters: Chapter[]; team?: TeamLine[]; shots?: (Shot | undefined)[] }
const { chapters, team = [], shots = [] } = Astro.props;
const lang = langOf(Astro.currentLocale);
const t = useT(lang);
const and = new Intl.ListFormat(TAG[lang], { type: 'conjunction' }); // en-GB: no serial comma
---
<div class="chs" data-chapters>
  <nav class="chs__toc" aria-label={t.case.chapters}>
    <div class="chs__rail">
      <b aria-hidden="true"></b>
      <i class="chs__tip" aria-hidden="true"></i>
      <ol role="list">
        {chapters.map((c, i) => <li><a href={`#ch-${i + 1}`} aria-current={i === 0 ? 'true' : undefined}>{c.label}</a></li>)}
      </ol>
    </div>
  </nav>
  <div class="chs__bar" aria-hidden="true"><i></i></div>
  <div class="chs__body">
    {chapters.map((c, i) => (<>
      <article class="ch" id={`ch-${i + 1}`} aria-labelledby={`ch-${i + 1}-h`}>
        <Tag>{c.label}</Tag>
        <Headline heading={c.heading} id={`ch-${i + 1}-h`} />
        {c.body?.length ? <div class="ch__body"><PortableText value={c.body} components={{ type: { figure: Figure } }} /></div> : null}
        {c.team && team.length ? (
          <dl class="ch__team">
            {byRole(team).map((l) => <div><dt class="tag">{t.case.roles[l.role as keyof typeof t.case.roles] ?? l.role}</dt><dd>{and.format(l.people)}</dd></div>)}
          </dl>
        ) : null}
      </article>
      {i < chapters.length - 1 && i < shots.length && (
        <figure class:list={['ch__shot', { 'ch__shot--ph': !shots[i] }]} data-inview>
          <WorkImage image={shots[i]} caption={shots[i]?.alt ?? t.case.shot} sizes="(min-width: 1024px) 68vw, 100vw" />
          {shots[i]?.caption && <figcaption class="small muted">{shots[i]?.caption}</figcaption>}
        </figure>
      )}
    </>))}
    <slot />
  </div>
</div>

<script>
  import { ScrollTrigger } from '@/scripts/gsap';
  import { scrollTo } from '@/scripts/scroll';

  for (const root of document.querySelectorAll<HTMLElement>('[data-chapters]')) {
    const links = [...root.querySelectorAll<HTMLAnchorElement>('.chs__toc a')];
    const chs = [...root.querySelectorAll<HTMLElement>('.ch')];
    const rail = root.querySelector<HTMLElement>('.chs__rail > b')!;
    const tip = root.querySelector<HTMLElement>('.chs__tip')!;
    const bar = root.querySelector<HTMLElement>('.chs__bar i')!;
    let cur = -1;
    const body = root.querySelector<HTMLElement>('.chs__body')!;
    // Scrubbed, no transition: the fill follows the scroll exactly (Lenis already smooths it). Piecewise:
    // while the middle of the screen crosses chapter i, the tip crosses label i (the last chapter runs to the
    // end of the content), so the line and the current label always agree.
    const update = (p: number) => {
      const read = p * body.offsetHeight;
      const tops = chs.map((ch) => ch.offsetTop - body.offsetTop);
      let i = 0;
      while (i < tops.length - 1 && read >= tops[i + 1]) i++;
      const end = i < tops.length - 1 ? tops[i + 1] : body.offsetHeight;
      const k = Math.min(1, Math.max(0, (read - tops[i]) / Math.max(1, end - tops[i])));
      const a = links[i];
      const y = a.offsetTop + k * a.offsetHeight;
      rail.style.transform = `scaleY(${y / rail.offsetHeight})`;
      tip.style.transform = `translateY(${y}px)`;
      bar.style.transform = `scaleX(${p})`;
      let c = 0;
      chs.forEach((ch, i) => { if (ch.getBoundingClientRect().top < innerHeight * 0.5) c = i; });
      if (c === cur) return;
      cur = c;
      links.forEach((a, i) => (i === c ? a.setAttribute('aria-current', 'true') : a.removeAttribute('aria-current')));
    };
    ScrollTrigger.create({
      trigger: root.querySelector('.chs__body'), start: 'top 50%', end: 'bottom 50%',
      onUpdate: (s) => update(s.progress), onRefresh: (s) => { cur = -1; update(s.progress); },
    });
    links.forEach((a, i) => a.addEventListener('click', (e) => { e.preventDefault(); scrollTo(chs[i]); history.replaceState(null, '', a.hash); }));
  }
</script>

<style lang="scss">
  .chs {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-block);

    @include mq(lg) {
      grid-template-columns: calc(var(--cell) * 3) minmax(0, 1fr);
      gap: var(--cell);
    }
  }

  .chs__toc {
    display: none;

    @include mq(lg) { display: block; }

    .chs__rail {
      position: sticky;
      top: calc(var(--header-h) + var(--space-6));
      display: grid;
      gap: var(--space-1);
      padding-left: var(--space-4);
      border-left: 1px solid var(--border);
    }

    ol { display: grid; gap: var(--space-1); }

    b {
      position: absolute;
      top: 0;
      bottom: 0;
      left: -1px;
      width: 1px;
      background: var(--text);
      transform: scaleY(0);
      transform-origin: top;
    }

    // The accent pixel on the rail's tip.
    .chs__tip {
      position: absolute;
      top: -3px;
      left: -4px;
      width: 7px;
      height: 7px;
      background: var(--accent);
    }

    a {
      position: relative;
      display: block;
      padding-block: var(--space-2);
      color: var(--muted);
      transition: color var(--duration-fast) var(--ease-soft);

      @include text(tag);

      text-transform: uppercase;

      &:hover, &[aria-current='true'] { color: var(--text); }
    }
  }

  // Under lg: 2px progress under the navbar, only while the chapters are on screen.
  .chs__bar {
    position: sticky;
    top: var(--header-h);
    z-index: var(--layer-dropdown);
    height: 2px;
    margin-bottom: calc(var(--space-block) * -1 - 2px);

    @include mq(lg) { display: none; }

    i {
      display: block;
      height: 100%;
      background: var(--text);
      transform: scaleX(0);
      transform-origin: left;
    }
  }

  .chs__body {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: calc(var(--cell) * 2);
    min-width: 0;
  }

  .ch {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-5);
    scroll-margin-top: calc(var(--header-h) + var(--space-6));

    :global(h2) { max-width: 18ch; }
  }

  .ch__body {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-block);

    > :global(p) { max-width: 56ch; color: var(--muted); }
    :global(p a) { color: var(--text); text-decoration: underline; text-underline-offset: 0.2em; }
  }

  .ch__shot {
    display: grid;
    gap: var(--space-3);
    margin: 0;

    > :global(:first-child) { overflow: hidden; }
  }

  .ch__shot--ph > :global(:first-child) { aspect-ratio: 16 / 10; }

  @include motion {
    .ch__shot > :global(:first-child) { transition: clip-path var(--duration-slow) var(--ease-move); }
    .ch__shot :global(img) { transition: scale 1.4s var(--ease-move); }

    :global(.js) .ch__shot:not(:global(.is-in)) {
      > :global(:first-child) { clip-path: inset(6% 6% 6% 6%); }
      :global(img) { scale: 1.08; }
    }
  }

  // Credits: one hairline row per role, the role as a tag, the people after it (2 columns from md).
  .ch__team {
    display: grid;
    margin: 0;
    border-bottom: 1px solid var(--border);

    > div {
      display: grid;
      gap: var(--space-1) var(--space-5);
      padding-block: var(--space-4);
      border-top: 1px solid var(--border);

      @include mq(md) { grid-template-columns: minmax(0, 2fr) minmax(0, 3fr); align-items: baseline; }
    }

    dt { color: var(--muted); }

    dd { margin: 0; }
  }
</style>
