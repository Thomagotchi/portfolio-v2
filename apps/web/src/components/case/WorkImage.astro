---
// A case-study image from src/assets/work (optimised by astro:assets: AVIF/WebP, responsive widths), or the
// hatched placeholder while there is none. Fills its box (object-fit: cover); the box sets the ratio.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Placeholder from '@/components/ui/Placeholder.astro';
import type { LocalImage } from '@/lib/types';

interface Props { image?: LocalImage; caption: string; sizes: string; class?: string; eager?: boolean }
const { image, caption, sizes, class: cls, eager } = Astro.props;
const files = import.meta.glob<{ default: ImageMetadata }>('/src/assets/work/**/*.{png,jpg,jpeg,webp}');
const load = image && files[`/src/assets/work/${image.file}`];
const src = load ? (await load()).default : undefined;
---
{src && image
  ? <Image src={src} alt={image.alt} widths={[480, 800, 1200, 1600, 2048].filter((w) => w <= src.width)} sizes={sizes} class:list={['wi', cls]} loading={eager ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : undefined} />
  : <Placeholder caption={caption} class={cls} />}

<style>
  .wi {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
