---
// Navbar: mark left, links right. Items with a panel open a hairline grid under the bar (desktop/tablet).
// Mobile: the Menu button (a disclosure) opens a sheet under the bar with panel items nested; the bar
// (mark, language, button) stays on top and usable, the rest of the page goes inert and stops scrolling.
import Mark from '@/components/ui/Mark.astro';
import LangSwitch from '@/components/ui/LangSwitch.astro';
import type { Site } from '@/lib/types';
import { localize, langOf, useT, type Lang } from '@/i18n';

interface Props { site: Site; alt: Record<Lang, string> }
const { site, alt } = Astro.props;
const lang = langOf(Astro.currentLocale);
const t = useT(lang);
const to = (href: string) => localize(href, lang);
---
<header class="nav" data-nav>
  <div class="nav__bar">
    <a class="nav__home" href={to('/')} aria-label={t.home(site.name)}><Mark size={22} /></a>
    <nav class="nav__links" aria-label={t.navMain}>
      <ul role="list">
        {site.nav.map((n, i) => (
          <li>
            {n.panel?.length
              ? <button class="nav__link" type="button" aria-expanded="false" aria-controls={`panel-${i}`} data-panel={i}>{n.label} <i class="nav-plus" aria-hidden="true"></i></button>
              : <a class="nav__link" href={to(n.href)}>{n.label}</a>}
          </li>
        ))}
      </ul>
      <span class="nav__ind" aria-hidden="true" data-ind></span>
    </nav>
    <LangSwitch alt={alt} class="nav__lang" />
    <button class="nav__menu" type="button" aria-expanded="false" aria-controls="nav-sheet" data-menu data-open={t.menu} data-close={t.close}>
      <span data-menu-label>{t.menu}</span><span class="nav__menu-ghost" aria-hidden="true">{t.close}</span>
    </button>
  </div>
  <div class="nav__drop" data-drop>
    {site.nav.map((n, i) => n.panel?.length ? (
      <ul role="list" class="nav__panel" id={`panel-${i}`} data-for={i} hidden>
        {n.panel.map((c, j) => (
          <li style={`--d:${j * 0.06}s`}>
            <a class="cell" href={to(c.href)}><span class="tag">{c.eyebrow}</span><b>{c.title}</b>{c.text && <span class="small muted">{c.text}</span>}</a>
          </li>
        ))}
      </ul>
    ) : null)}
  </div>
  <div class="sheet" id="nav-sheet" data-sheet data-lenis-prevent hidden>
    <ul role="list" class="sheet__list">
      {site.nav.map((n, i) => (
        <li style={`--i:${i}`}>
          <a class="sheet__link" href={to(n.href)} data-menu-link>{n.label}</a>
          {n.panel?.length ? (
            <ul role="list" class="sheet__sub">
              {n.panel.map((c) => <li><a href={to(c.href)} data-menu-link><span class="tag">{c.eyebrow}</span> {c.title}</a></li>)}
            </ul>
          ) : null}
        </li>
      ))}
    </ul>
  </div>
</header>

<script>
  import { lockScroll } from '@/scripts/scroll';
  import { menu } from '@/scripts/menu';
  import { decode } from '@/scripts/decode';

  const nav = document.querySelector<HTMLElement>('[data-nav]')!;
  const drop = nav.querySelector<HTMLElement>('[data-drop]')!;
  const panels = menu({
    triggers: [...nav.querySelectorAll<HTMLButtonElement>('[data-panel]')],
    zones: [nav.querySelector<HTMLElement>('.nav__bar')!, drop],
    show: (t) => {
      drop.querySelectorAll<HTMLElement>('[data-for]').forEach((p) => (p.hidden = p.dataset.for !== t.dataset.panel));
      drop.classList.add('is-open');
    },
    hide: () => drop.classList.remove('is-open'),
  });
  nav.querySelectorAll('a.nav__link, .nav__home, [data-lsw]').forEach((a) => a.addEventListener('pointerenter', panels.close));

  // One underline for the whole bar: it grows from the left under the first link reached, then slides to
  // the next one hovered or focused, and rests under an open panel's trigger; it shrinks away when none.
  const ind = nav.querySelector<HTMLElement>('[data-ind]')!;
  const links = [...nav.querySelectorAll<HTMLElement>('.nav__link')];
  let hover: HTMLElement | null = null;
  const sync = () => {
    const to = hover ?? links.find((l) => l === document.activeElement && l.matches(':focus-visible')) ?? links.find((l) => l.getAttribute('aria-expanded') === 'true');
    if (!to) { ind.classList.remove('is-on'); return; }
    const box = { x: to.offsetLeft, w: to.offsetWidth };
    if (!ind.classList.contains('is-on')) {
      ind.classList.add('is-still'); // the first show places it at once, then grows
      void ind.offsetWidth;
    }
    ind.style.setProperty('--x', `${box.x}px`);
    ind.style.setProperty('--w', `${box.w}px`);
    void ind.offsetWidth;
    ind.classList.remove('is-still');
    ind.classList.add('is-on');
  };
  // Hover holds across the gaps between links: it ends when the pointer leaves the list.
  nav.querySelector('.nav__links ul')!.addEventListener('pointerleave', () => { hover = null; sync(); });
  links.forEach((l) => {
    l.addEventListener('pointerenter', () => { hover = l; sync(); });
    l.addEventListener('focus', sync);
    l.addEventListener('blur', () => requestAnimationFrame(sync));
  });
  new MutationObserver(sync).observe(nav, { subtree: true, attributeFilter: ['aria-expanded'] });
  drop.addEventListener('click', (e) => { if ((e.target as Element).closest('a')) panels.close(); });

  // The sheet (data-lenis-prevent: Lenis cancels every scroll while stopped, the sheet's own included).
  // Open: the label decodes Menu → Fermer, the sheet wipes in diagonally from the top-right corner; the
  // page behind goes inert. Close: the same path backwards, then hidden. Esc closes.
  const sheet = nav.querySelector<HTMLElement>('[data-sheet]')!;
  const btn = nav.querySelector<HTMLButtonElement>('[data-menu]')!;
  const label = btn.querySelector<HTMLElement>('[data-menu-label]')!;
  const rm = () => matchMedia('(prefers-reduced-motion: reduce)').matches;
  const behind = () => document.querySelectorAll<HTMLElement>('body > :not(header, script)');
  const isOpen = () => btn.getAttribute('aria-expanded') === 'true';
  const set = (open: boolean) => {
    btn.setAttribute('aria-expanded', String(open));
    behind().forEach((el) => (el.inert = open));
    lockScroll(open);
    decode(label, open ? btn.dataset.close : btn.dataset.open, 450);
  };
  const openSheet = () => {
    sheet.classList.remove('is-closing');
    sheet.hidden = false;
    set(true);
  };
  const closeSheet = (instant = false) => {
    if (!isOpen()) return;
    set(false);
    if (instant || rm()) { sheet.hidden = true; return; }
    sheet.classList.add('is-closing');
    const done = (e: AnimationEvent) => {
      if (e.target !== sheet) return; // the rows' own exits bubble up first
      sheet.removeEventListener('animationend', done);
      if (sheet.classList.contains('is-closing')) { sheet.classList.remove('is-closing'); sheet.hidden = true; }
    };
    sheet.addEventListener('animationend', done);
  };
  btn.addEventListener('click', () => (isOpen() ? closeSheet() : openSheet()));
  addEventListener('keydown', (e) => { if (e.key === 'Escape' && isOpen()) { closeSheet(); btn.focus(); } });
  sheet.querySelectorAll('[data-menu-link]').forEach((a) => a.addEventListener('click', () => closeSheet(true)));
  // Resizing across 768 while a menu is open: close at once (the sheet would hide but keep the page locked).
  matchMedia('(width >= 768px)').addEventListener('change', () => { closeSheet(true); panels.close(); });
</script>

<style lang="scss">
  .nav {
    position: sticky;
    top: 0;
    z-index: var(--layer-navbar);
    background: var(--bg);
  }

  .nav__bar {
    position: relative; // the language dropdown hangs from it
    display: flex;
    align-items: center;
    gap: var(--space-2);
    height: var(--header-h);
    padding-inline: var(--margin);
    border-bottom: 1px solid var(--border);

    @include mq(md) { padding-inline: var(--cell); }
  }

  .nav__home {
    display: grid;
    place-items: center;
    min-width: 44px;
    min-height: 44px;
    margin-left: -11px;
    color: var(--text);
  }

  // Links fill the bar's height so their underline lands on its bottom border (grid lines, not text lines).
  .nav__links {
    display: none;
    align-self: stretch;
    margin-left: auto;

    @include mq(md) { display: block; }

    ul {
      display: flex;
      height: 100%;
      gap: 18px;

      @include mq(lg) { gap: 22px; }
    }
  }

  .nav__link {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    height: 100%;
    min-height: 44px;

    @include text(nav);

    color: var(--nav-rest);
    text-decoration: none;
    transition: color var(--duration-fast);

    &:is(:hover, :focus-visible, [aria-expanded='true']) { color: var(--text); }
  }

  // The shared underline (script above), on the bar's bottom border. Without JS: none, the colour carries it.
  .nav__links { position: relative; }

  .nav__ind {
    position: absolute;
    bottom: -1px;
    left: 0;
    width: var(--w, 0);
    height: 1px;
    background: var(--text);
    translate: var(--x, 0) 0;
    scale: 0 1;
    transform-origin: left;
    transition: translate 0.5s var(--ease-move), width 0.5s var(--ease-move), scale 0.45s var(--ease-soft);

    &:global(.is-on) { scale: 1; }
    &:global(.is-still) { transition: none; }

    @media (prefers-reduced-motion: reduce) { transition: none; }
  }

  .nav__drop {
    position: absolute;
    inset: 100% 0 auto;
    z-index: var(--layer-dropdown);
    background: var(--bg);
    border-bottom: 1px solid var(--border);
    clip-path: inset(0 0 100% 0);
    visibility: hidden;
    transition: clip-path 0.7s var(--ease-move), visibility 0s 0.7s;

    &:global(.is-open) {
      clip-path: inset(0);
      visibility: visible;
      transition: clip-path 0.7s var(--ease-move);
    }
  }

  // Hairlines between items from the gap (1px over the border colour), so a second row gets them too.
  // Tablet: 2 per row (an odd last item spans the row); desktop: one row of cells, at least 200px.
  .nav__panel {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    margin-inline: var(--cell);
    background: var(--border);

    @include mq(lg) { grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); }

    &[hidden] { display: none; }

    li { background: var(--bg); }

    li:last-child:nth-child(odd) {
      grid-column: 1 / -1;

      @include mq(lg) { grid-column: auto; }
    }
  }

  .cell {
    display: grid;
    gap: 6px;
    height: 100%;
    padding: var(--space-card);
    color: var(--text);
    text-decoration: none;

    b { @include text(h3); }

    // Hover: the other links step back (on the children: the cell's own opacity is the entry fade).
    > * { transition: opacity var(--duration-fast); }
    .nav__panel:has(.cell:is(:hover, :focus-visible)) &:not(:hover, :focus-visible) > * { opacity: 0.35; }
  }

  @include motion {
    .cell {
      opacity: 0;
      translate: 0 -6px;
      transition: opacity 0.5s var(--ease-soft) var(--d), translate 0.5s var(--ease-soft) var(--d);

      :global(.is-open) & { opacity: 1; translate: 0; }
    }
  }

  .nav__bar > :global(.nav__lang) {
    margin-left: auto;

    @include mq(md) { margin-left: var(--space-5); }
  }

  // Both labels share one grid cell (the hidden one only sets the width): Menu ↔ Fermer never moves the
  // language switch beside it.
  .nav__menu {
    display: inline-grid;
    place-items: center end;
    margin-left: var(--space-4);
    min-height: 44px;

    @include text(nav);

    > * { grid-area: 1 / 1; }

    @include mq(md) { display: none; }
  }

  .nav__menu-ghost { visibility: hidden; }

  // Under the bar, down to the bottom of the screen; scrolls on its own when the list is taller.
  .sheet {
    position: fixed;
    inset: var(--header-h) 0 0;
    padding: 0 var(--margin) var(--space-block);
    background: var(--bg);
    color: var(--text);
    overflow-y: auto;
    overscroll-behavior: contain;

    @include mq(md) { display: none; }
  }

  // Open: a diagonal wipe from the top-right corner (under the Menu button) to the bottom-left; then the
  // rows' hairlines draw from the left and the links rise. Close: the rows drop away, the wipe runs back
  // into the corner. The triangle's far points sit at 200% / -100%, so at the end it covers the whole sheet.
  @include motion {
    .sheet {
      animation: sheet-in 0.8s var(--ease-move) both;

      .sheet__list > li {
        &::before { animation: sheet-line 0.8s var(--ease-move) calc(0.35s + var(--i) * 0.07s) both; }

        > * { animation: sheet-rise 0.7s var(--ease-move) calc(0.4s + var(--i) * 0.07s) both; }
      }

      &:global(.is-closing) {
        animation: sheet-out 0.7s var(--ease-move) 0.15s both;

        .sheet__list > li::before, .sheet__list > li > * { animation: sheet-drop 0.25s var(--ease-soft) both; }
      }
    }
  }

  @keyframes sheet-in {
    from { clip-path: polygon(100% 0, 100% 0, 100% 0); }
    to { clip-path: polygon(100% 0, 100% 200%, -100% 0); }
  }

  @keyframes sheet-out {
    from { clip-path: polygon(100% 0, 100% 200%, -100% 0); }
    to { clip-path: polygon(100% 0, 100% 0, 100% 0); }
  }

  @keyframes sheet-line { from { scale: 0 1; } }

  @keyframes sheet-rise { from { opacity: 0; translate: 0 28px; } }

  @keyframes sheet-drop { to { opacity: 0; translate: 0 10px; } }

  // The hairline is a pseudo-element so it can draw in from the left.
  .sheet__list > li {
    position: relative;
    padding-block: var(--space-stack);

    &::before {
      content: '';
      position: absolute;
      inset: 0 0 auto;
      height: 1px;
      background: var(--border);
      transform-origin: left;
    }
  }

  .sheet__link {
    display: block;
    padding-block: var(--space-2);

    @include text(h3);

    color: var(--text);
    text-decoration: none;
  }

  .sheet__sub {
    display: grid;
    padding-bottom: var(--space-2);

    a {
      display: flex;
      align-items: baseline;
      gap: var(--space-inline);
      min-height: 44px;
      padding-block: var(--space-3);
      color: var(--muted);
      text-decoration: none;
    }
  }
</style>
