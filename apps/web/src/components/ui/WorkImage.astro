---
// A case-study image from Sanity, optimised at build by astro:assets (AVIF/WebP, responsive widths), or the
// hatched placeholder while there is none. With a video: the image stays underneath as its poster (a lazy
// <img>, not the poster attribute, which downloads at once and competes with the fonts), the file is attached
// after load and plays muted in a loop while on screen, fading in once it plays (never under reduced motion).
// Fills its box (object-fit: cover); the box sets the ratio.
import { Image } from 'astro:assets';
import Placeholder from '@/components/ui/Placeholder.astro';
import { imageUrl } from '@/lib/sanity';
import type { SanityImage } from '@/lib/types';

interface Props { image?: SanityImage; video?: string; caption: string; sizes: string; class?: string; eager?: boolean }
const { image, video, caption, sizes, class: cls, eager } = Astro.props;
// Sanity asset ids carry the original size (image-<hash>-<w>x<h>-<ext>): never ask for wider than the file.
const width = Number(image?.asset?._ref.match(/-(\d+)x\d+-/)?.[1] ?? 0);
const src = width ? imageUrl(image!, Math.min(width, 2048)) : '';
---
{src
  ? video
    ? (
      <span class:list={['wv', cls]}>
        <Image src={src} inferSize alt={image?.alt ?? ''} widths={[480, 800, 1200, 1600, 2048].filter((w) => w <= width)} sizes={sizes} class="wi" loading="lazy" />
        <video class="wi wv__v" data-video={video} muted loop playsinline preload="none" aria-hidden="true"></video>
      </span>
    )
    : <Image src={src} inferSize alt={image?.alt ?? ''} widths={[480, 800, 1200, 1600, 2048].filter((w) => w <= width)} sizes={sizes} class:list={['wi', cls]} loading={eager ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : undefined} />
  : <Placeholder caption={caption} class={cls} />}

<script>
  // Videos: attach the file once the page has loaded (scripts run after load), play only while visible.
  if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const io = new IntersectionObserver((entries) => entries.forEach(({ target, isIntersecting }) => {
      const v = target as HTMLVideoElement;
      if (isIntersecting) {
        if (!v.src) { v.src = v.dataset.video!; v.addEventListener('playing', () => v.classList.add('is-on'), { once: true }); }
        v.play().catch(() => {});
      } else v.pause();
    }), { rootMargin: '200px' });
    document.querySelectorAll<HTMLVideoElement>('video[data-video]').forEach((v) => io.observe(v));
  }
</script>

<style lang="scss">
  .wi {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .wv {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
  }

  .wv__v {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity var(--duration-base) var(--ease-soft);

    &.is-on { opacity: 1; }
  }
</style>
