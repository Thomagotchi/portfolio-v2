---
// A name framed by four 1px corners that close in on enter.
---
<span class="bk"><i></i><i></i><i></i><i></i><slot /></span>

<style lang="scss">
  .bk {
    position: relative;
    display: grid;
    place-items: center;
    min-height: 68px;
    padding: var(--space-4) var(--space-5);

    @include text(h3);

    line-height: 1;
    color: var(--text);
    text-align: center;
  }

  i {
    position: absolute;
    width: 10px;
    height: 10px;
    border: 0 solid color-mix(in srgb, var(--text) 45%, transparent);
    transition: translate var(--duration-slow) var(--ease-move), opacity var(--duration-base) var(--ease-soft), border-color var(--duration-fast);

    &:nth-child(1) { left: 0; top: 0; border-width: 1px 0 0 1px; --o: -12px, -12px; --h: 5px, 5px; }
    &:nth-child(2) { right: 0; top: 0; border-width: 1px 1px 0 0; --o: 12px, -12px; --h: -5px, 5px; }
    &:nth-child(3) { left: 0; bottom: 0; border-width: 0 0 1px 1px; --o: -12px, 12px; --h: 5px, -5px; }
    &:nth-child(4) { right: 0; bottom: 0; border-width: 0 1px 1px 0; --o: 12px, 12px; --h: -5px, -5px; }
  }

  // Closed in by the nearest [data-inview] ancestor getting .is-in (scripts/inview.ts).
  @include motion {
    :global(.js [data-inview]:not(.is-in)) .bk i { opacity: 0; translate: var(--o); }
  }

  .bk:hover i { border-color: var(--text); translate: var(--h); }
</style>
