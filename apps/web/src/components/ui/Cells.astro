---
// Label / value pairs in a hairline row (meta, results, facts). n = columns [mobile, md, lg].
// figure: values roll in as odometers when the row scrolls in. A cell with href links out (new tab): the
// whole cell is the click target (stretched link), the brackets still frame it.
import Odometer from './Odometer.astro';
import type { Cell } from '@/lib/types';

interface Props { items: Cell[]; n: [number, number, number]; figure?: boolean; class?: string }
const { items, n, figure = false, class: cls } = Astro.props;
---
<dl class:list={['cells', { 'cells--fig': figure }, cls]} data-brackets style={`--n:${n[0]};--n-md:${n[1]};--n-lg:${n[2]}`} data-inview={figure ? '' : undefined}>
  {items.map((c) => figure
    ? <div><dt class="small muted">{c.label}</dt><dd><Odometer value={c.value} /></dd></div>
    : <div><dt class="tag">{c.label}</dt><dd>{c.href
        ? <a href={c.href} target="_blank" rel="noopener" class="cells__a">{c.value}</a>
        : c.value}</dd></div>)}
</dl>

<style lang="scss">
  // Balanced wrapping: a two-line value splits evenly instead of leaving one word alone.
  dd { margin: 0; text-wrap: balance; }

  .cells > div:has(.cells__a) { position: relative; }

  // Outbound link: no arrow; the underline draws in from the left on hover and retracts to the left (the
  // navbar links' bar). The whole cell is the click target (stretched ::after).
  .cells__a {
    color: var(--text);
    text-decoration: none;
    background: linear-gradient(currentcolor, currentcolor) left bottom / 0 1px no-repeat;
    transition: background-size 0.45s var(--ease-soft);

    &::after { content: ''; position: absolute; inset: 0; }

    &:hover, &:focus-visible { background-size: 100% 1px; }
  }

  // Figure cells: the number shows first, the label under it (dt stays first in the markup).
  .cells--fig > div { gap: var(--space-4); padding-block: var(--space-5); }
  .cells--fig dd { order: -1; }
</style>
