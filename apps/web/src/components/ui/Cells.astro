---
// Label / value pairs in a hairline row (meta, results, facts). n = columns [mobile, md, lg].
// figure: values roll in as odometers when the row scrolls in.
import Odometer from './Odometer.astro';
import type { Cell } from '@/lib/types';

interface Props { items: Cell[]; n: [number, number, number]; figure?: boolean; class?: string }
const { items, n, figure = false, class: cls } = Astro.props;
---
<dl class:list={['cells', { 'cells--fig': figure }, cls]} style={`--n:${n[0]};--n-md:${n[1]};--n-lg:${n[2]}`} data-inview={figure ? '' : undefined}>
  {items.map((c) => figure
    ? <div><dt class="small muted">{c.label}</dt><dd><Odometer value={c.value} /></dd></div>
    : <div><dt class="tag">{c.label}</dt><dd>{c.value}</dd></div>)}
</dl>

<style lang="scss">
  dd { margin: 0; }

  // Figure cells: the number shows first, the label under it (dt stays first in the markup).
  .cells--fig > div { gap: var(--space-4); padding-block: var(--space-5); }
  .cells--fig dd { order: -1; }
</style>
