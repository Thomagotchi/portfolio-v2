---
// Sanity `page` documents (home = slug "index"). Routes: pages/[...slug].astro (fr), pages/en/[...slug].astro.
import Base from '@/layouts/Base.astro';
import Blocks from '@/components/sections/Blocks.astro';
import { getSite } from '@/lib/sanity';
import type { Page, FaqBlock, OffersBlock } from '@/lib/types';
import { cleanPath } from '@/lib/url';
import type { Lang } from '@/i18n';

interface Props { page: Page; lang: Lang }
const { page, lang } = Astro.props;
const site = await getSite(lang);
const faqs = page.blocks.filter((b): b is FaqBlock => b._type === 'faq').flatMap((b) => b.items);
const offers = page.blocks.filter((b): b is OffersBlock => b._type === 'offers').flatMap((b) => b.items);
const jsonLd = [
  { '@type': 'WebPage', name: page.title, url: new URL(cleanPath(Astro.url.pathname), Astro.site).href, dateModified: page._updatedAt },
  ...(offers.length ? [{
    '@type': 'ProfessionalService', name: site.name, url: Astro.site?.href, areaServed: 'FR', provider: { '@id': `${Astro.site}#person` },
    makesOffer: offers.map((o) => ({ '@type': 'Offer', itemOffered: { '@type': 'Service', name: o.title, description: o.meta } })),
  }] : []),
  ...(faqs.length ? [{ '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.question, acceptedAnswer: { '@type': 'Answer', text: f.answer } })) }] : []),
];
---
<Base title={page.title} site={site} seo={page.seo} jsonLd={jsonLd} path={page.slug === 'index' ? '/' : `/${page.slug}`}>
  <Blocks blocks={page.blocks} />
</Base>
