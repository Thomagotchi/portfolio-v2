---
// Case study: header + meta cells, cover window, results, chapters with the index, quote, gallery, next.
import Base from '@/layouts/Base.astro';
import Cells from '@/components/ui/Cells.astro';
import PageHeader from '@/components/ui/PageHeader.astro';
import Button from '@/components/ui/Button.astro';
import Section from '@/components/ui/Section.astro';
import Window from '@/components/ui/Window.astro';
import Chapters from '@/components/case/Chapters.astro';
import NextProject from '@/components/case/NextProject.astro';
import WorkImage from '@/components/case/WorkImage.astro';
import { getSite } from '@/lib/sanity';
import type { CaseStudy } from '@/lib/types';
import { cleanPath } from '@/lib/url';
import { useT, type Lang } from '@/i18n';

// Routes: pages/projets/[slug].astro (fr), pages/en/work/[slug].astro.
interface Props { cs: CaseStudy; lang: Lang }
const { cs, lang } = Astro.props;
const t = useT(lang).case;
const site = await getSite(lang);
const url = new URL(cleanPath(Astro.url.pathname), Astro.site).href;
const year = cs.meta.find((m) => m.label === t.year)?.value;
const jsonLd = [{
  '@type': 'CreativeWork', '@id': `${url}#work`, name: cs.title, headline: `${cs.heading.lead} ${cs.heading.muted ?? ''} ${cs.heading.tail ?? ''}`.trim(),
  description: cs.lede, url, creator: { '@id': `${Astro.site}#person` }, ...(year && { dateCreated: year }),
  keywords: cs.meta.find((m) => m.label === t.stack)?.value, dateModified: cs._updatedAt,
}];
const solo = !!cs.screen && !cs.mobile;
---
<Base title={cs.title} site={site} seo={cs.seo ?? { description: cs.lede }} jsonLd={jsonLd} path={`/work/${cs.slug}`}>
  <PageHeader label={cs.label} heading={cs.heading} lede={cs.lede}>
    <Cells items={cs.meta} n={[2, 3, cs.meta.length]} class="cs-meta" />
    {cs.source && <div class="cs-src"><Button href={cs.source.href} variant="secondary" rel="noopener" target="_blank">{cs.source.label}</Button></div>}
  </PageHeader>

  <div class="cs-cv">
    <Window>
      <WorkImage image={cs.cover} video={cs.coverVideo} caption={t.cover} sizes="(min-width: 768px) 92vw, 100vw" class="cs-cv__img" />
    </Window>
  </div>

  {cs.results?.length ? (
    <Section label={t.results}>
      <Cells items={cs.results} n={[2, 2, 4]} figure />
    </Section>
  ) : null}

  <Section>
    <Chapters chapters={cs.chapters} team={cs.team}>
      {cs.quote && (
        <figure class="cs-qt">
          <blockquote><p>{cs.quote.text}</p></blockquote>
          <figcaption class="tag">{cs.quote.cite}</figcaption>
        </figure>
      )}
      {/* A screen without a mobile shot takes the full width; with neither, both placeholders show. */}
      <div class:list={['cs-gal', { 'cs-gal--solo': solo }]}>
        <WorkImage image={cs.screen} video={cs.screenVideo} caption={t.screen} sizes={solo ? '(min-width: 1024px) 68vw, 100vw' : '(min-width: 1024px) 45vw, (min-width: 768px) 60vw, 100vw'} />
        {!solo && <WorkImage image={cs.mobile} caption={t.mobile} sizes="(min-width: 1024px) 22vw, (min-width: 768px) 30vw, 100vw" />}
      </div>
      {cs.source && <p class="cs-credit muted">{t.credit} <a href={cs.source.href} rel="noopener" target="_blank">{cs.source.label}</a></p>}
    </Chapters>
  </Section>

  {cs.next && <NextProject {...cs.next} />}
</Base>

<style lang="scss">
  // Cover: margin to margin, 2:1 (4:3 on mobile); the window opens as it scrolls in.
  .cs-cv {
    position: relative;
    margin-inline: var(--margin);
    aspect-ratio: 4 / 3;

    @include mq(md) { aspect-ratio: 2 / 1; }

    :global(.cs-cv__img) { position: absolute; inset: 0; }
  }

  .cs-src { margin-top: var(--space-5); }

  .cs-credit a {
    color: var(--text);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .cs-qt {
    display: grid;
    gap: var(--space-5);
    margin: 0;
    padding-block: var(--cell);
    border-block: 1px solid var(--border);

    blockquote { margin: 0; }

    p {
      max-width: 30ch;

      @include text(h3);
    }
  }

  .cs-gal {
    display: grid;
    gap: var(--space-5);

    @include mq(md) { grid-template-columns: minmax(0, 2fr) minmax(0, 1fr); }

    > :global(:first-child) { aspect-ratio: 16 / 10; }
    > :global(:last-child) { aspect-ratio: 9 / 12; }
  }

  .cs-gal--solo {
    @include mq(md) { grid-template-columns: minmax(0, 1fr); }

    // Full width: 2:1, a desktop screenshot's own ratio (16:10 cropped its edges).
    > :global(:last-child) { aspect-ratio: 2 / 1; }
  }
</style>
