---
import { Font } from 'astro:assets';
import 'tokens/tokens.css';
import '@/styles/global.scss';
import 'lenis/dist/lenis.css'; // ~300 B, only applies when Lenis adds .lenis to <html>
import Seo from '@/components/seo/Seo.astro';
import JsonLd from '@/components/seo/JsonLd.astro';
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
import type { Seo as SeoData, Site } from '@/lib/types';
import { SITE } from '@/config';
import { fontAliases } from '@/lib/fonts';
import head from '@/scripts/head.js?raw';
import { alternates, canonicalOf, DEFAULT_LANG, langOf, LOCALES, TAG, useT } from '@/i18n';

// `path`: the canonical path of this page (/about, /work/x). Defaults to the served one, mapped back.
interface Props { title: string; site: Site; seo?: SeoData; jsonLd?: Record<string, unknown>[]; path?: string; og?: string }
const { title, site, seo, jsonLd = [], og } = Astro.props; // og: a page's own share image (path), else the site's
const lang = langOf(Astro.currentLocale);
const t = useT(lang);
const alt = alternates(Astro.props.path ?? canonicalOf(Astro.url.pathname));
const graph = [
  { '@type': 'WebSite', '@id': `${Astro.site}#website`, url: Astro.site?.href, name: site.name, description: site.description, inLanguage: LOCALES.map((l) => TAG[l]), publisher: { '@id': `${Astro.site}#person` } },
  {
    '@type': 'Person', '@id': `${Astro.site}#person`, name: site.name, jobTitle: site.role.split('·')[0].trim(), url: Astro.site?.href,
    email: `mailto:${site.contact.email}`, address: { '@type': 'PostalAddress', addressCountry: 'FR' }, sameAs: site.socials?.map((s) => s.href),
  },
  ...jsonLd,
];
---
<!doctype html>
<html lang={lang} data-theme={SITE.theme}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline set:html={head} />
    <Seo title={title} seo={seo} image={new URL(og ?? (lang === 'en' ? '/og-image-en.png' : '/og-image.png'), Astro.site).href} lang={lang} />
    {!seo?.noindex && <>
      {LOCALES.map((l) => <link rel="alternate" hreflang={l} href={new URL(alt[l], Astro.site).href} />)}
      <link rel="alternate" hreflang="x-default" href={new URL(alt[DEFAULT_LANG], Astro.site).href} />
    </>}
    <Font cssVariable="--font-display" preload />
    <Font cssVariable="--font-tag" preload />
    <Font cssVariable="--font-mono" />
    <Fragment set:html={`<style>:root{${fontAliases}}</style>`} />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#0C0C0E" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#F7F6F4" media="(prefers-color-scheme: light)" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <JsonLd graph={graph} />
  </head>
  <body>
    <div class="pt" aria-hidden="true"></div> {/* page curtain, first so it covers from the first paint */}
    <a class="skip-link" href="#main">{t.skip}</a>
    <Header site={site} alt={alt} />
    <main id="main" tabindex="-1">
      <slot />
      <div class="thread" data-thread aria-hidden="true"><i></i><b></b></div>
    </main>
    <Footer site={site} />
    <script>
      // Loaded on window load by integrations/defer-scripts.mjs: never delays FCP/LCP.
      import '@/scripts/main';
    </script>
  </body>
</html>
